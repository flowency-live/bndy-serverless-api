{
  "name": "builders-lambda",
  "version": "1.0.0",
  "description": "BNDY Builder persona management Lambda function",
  "main": "handler.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": ["lambda", "builders", "bndy", "white-label"],
  "author": "BNDY Team",
  "license": "UNLICENSED",
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "handler.js",
      "routes/**/*.js",
      "!node_modules/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
