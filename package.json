{
  "name": "bndy-serverless-api",
  "version": "1.0.0",
  "description": "BNDY Serverless API - AWS Lambda functions",
  "scripts": {
    "validate": "node scripts/validate-deployment.js",
    "verify-routes": "node scripts/verify-routes.js",
    "security:inventory": "node scripts/security-route-inventory.js",
    "security:test": "node --test security/sec-01-route-policy.test.js",
    "test:security-inventory": "node --test scripts/__tests__/security-route-inventory.test.js",
    "test:artist-taxonomy": "node --test shared/artist-domain/taxonomy.test.js",
    "test:identity-sync": "node shared/identity/check-sync.test.js",
    "test:ingest-artist-domain": "node --test events-agent-lambda/lib/artist-domain.test.js",
    "predeploy": "npm run validate && npm run verify-routes && npm run security:test && npm run test:artist-taxonomy && npm run test:identity-sync && npm run test:ingest-artist-domain",
    "deploy": "sam build && sam deploy --no-confirm-changeset",
    "deploy:guided": "sam build && sam deploy --guided",
    "smoke-test": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "firebase-admin": "^13.5.0"
  }
}
